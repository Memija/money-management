{
  "name": "saldio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "sonar:scan": "npx sonarqube-scanner",
    "security:all": "node scripts/run-security-scan.js all",
    "security:audit": "npm audit --audit-level=critical",
    "security:secrets": "node scripts/check-secrets.js",
    "security:gitleaks": "node scripts/run-security-scan.js gitleaks",
    "security:osv": "node scripts/run-security-scan.js osv",
    "security:sbom": "cyclonedx-npm --ignore-npm-errors --output-file cyclonedx.sbom.json",
    "security:trivy": "node scripts/run-security-scan.js trivy",
    "security:zizmor": "node scripts/run-security-scan.js zizmor",
    "audit:licenses": "license-checker-rseidelsohn --production --summary --excludePrivatePackages --onlyAllow \"MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;CC0-1.0;0BSD;Unlicense;Python-2.0;OFL-1.1\"",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run security:secrets && npm run security:audit && npm run audit:licenses && npm run build && npm run test:coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.8.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.7.0",
    "react-virtuoso": "^4.18.7",
    "recharts": "^3.8.1",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "license-checker-rseidelsohn": "^5.0.1",
    "lint-staged": "^17.6.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.8.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^4.1.12"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,html}": [
      "prettier --write"
    ]
  }
}
